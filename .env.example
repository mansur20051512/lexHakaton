# ADOLAT.AI - Konfiguratsiya fayli (Namuna)
# Haqiqiy maxfiy kalitlaringizni bu yerga YOZMANG!
# Ushbu fayldan nusxa olib, nomini '.env' ga o'zgartiring va o'z kalitlaringizni kiriting.

# Django sozlamalari
SECRET_KEY=django-insecure-adolat-ai-lexhakaton-uzbekistan-legaltech-2026-super-secure
DEBUG=True
ALLOWED_HOSTS=*

# VoiceLab LLM & Voice API Sozlamalari (Aisha Orbit / Halo Vision)
# O'z shaxsiy VoiceLab API kalitingizni https://voicelab.uz portalidan oling
VOICE_MODE=voicelab
VOICELAB_API_KEY=vlk_your_voicelab_api_key_here
VOICELAB_BASE_URL=https://api.voicelab.uz
VOICELAB_LLM_MODEL=aisha-orbit

# Open-Source & OpenAI-compatible LLM Sozlamalari
LLM_API_URL=https://api.voicelab.uz/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=aisha-orbit
LLM_TIMEOUT=60
